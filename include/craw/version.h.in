#ifndef CRAW_VERSION_H
#define CRAW_VERSION_H

#include <stdint.h>
#include <craw/utils.h>

/**
 * Version from which the headers were built.
 */
#define CRAW_VERSION_MAJOR @CRAW_VERSION_MAJOR@
#define CRAW_VERSION_MINOR @CRAW_VERSION_MINOR@
#define CRAW_VERSION_MICRO @CRAW_VERSION_MICRO@

/**
 * Extract versions from the value returned by craw_version_int()
 */
#define CRAW_GET_VER_MAJOR(v) (((v) >> 16) & 0xFF)
#define CRAW_GET_VER_MINOR(v) (((v) >>  8) & 0xFF)
#define CRAW_GET_VER_MICRO(v) (((v) >>  0) & 0xFF)

/**
 * Returns the version of the library.
 */
CRAW_API uint32_t craw_version_int(void);

#endif /* CRAW_VERSION_H */
